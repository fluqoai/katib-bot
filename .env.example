# =============================================================================
# Kateb — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# The four groups you need to fill in (everything else is optional):
#   1. Supabase  (the database)
#   2. Telegram  (the bot token from @BotFather)
#   3. OpenRouter + an embedding provider (the AI)
# That's it. The client only ever talks to the Telegram bot.
# =============================================================================

# ---------- Telegram ----------
# Get from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Optional: restrict access to a specific chat / user. Comma-separated.
# Leave empty to allow anyone.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------- Supabase (new auth model) ----------
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) — server-side, full access, bypasses RLS.
# This is what the bot uses to read/write the index.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...) — for client-side / browser use.
# The bot does NOT need this; left here for reference only.
SUPABASE_PUBLISHABLE_KEY=
# Project ref only (for logging / scripts that need to build URLs).
SUPABASE_PROJECT_REF=
# Direct DB connection (for `psql` / migrations). Optional.
SUPABASE_DB_URL=
# Legacy: if your project still uses the old JWT-style service_role key,
# set it here instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM (OpenRouter) ----------
OPENROUTER_API_KEY=
# Default chat model for generation. Pick a model that handles Arabic well.
# Candidates: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o

# ---------- Embeddings ----------
# Provider-agnostic. Pick one of: openai | google
EMBEDDING_PROVIDER=openai
# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Google Generative AI (if EMBEDDING_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# ---------- App ----------
# Where the skill lives. Default points at the user-scope install of
# arabic-official-correspondence. Override only if you moved it.
KATEB_SKILL_PATH=C:/Users/khayrat/.minimax/skills/arabic-official-correspondence
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- CORS ----------
# Comma-separated list of origins that are allowed to call the API.
# In production (Vercel + VPS), set this to the public domain:
#   CORS_ORIGINS=https://katibai.xyz,https://www.katibai.xyz
# Vercel preview deployments are auto-allowed via the regex
# `https://*.vercel.app` (see api/main.py).
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ---------- Google Drive (OPTIONAL) ----------
# Skip this whole section if you don't use Drive. The recommended way to
# populate the index is `python scripts/add_doc.py` — no Google Cloud
# project needed.
#
# Service-account JSON path. Share the source folder with this service
# account's email as a Viewer.
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
# Root folder ID to ingest. If empty, the script lists accessible folders.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
