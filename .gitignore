# Acceptance tests — production code + the actual acceptance suite
# (tests/acceptance/) are committed. Everything else (underscore-prefixed
# diagnostic scripts, phase outputs, run reports, stale fixtures) is
# ephemeral and regenerated on every run.
tests/_outputs/
tests/_phase*_outputs/
tests/_uat_outputs/
tests/_*.py
tests/_*_output.txt
tests/_*_outputs/
tests/_*_input.docx
tests/_phase3_demo.txt
tests/SETUP_BUCKETS.md
tests/test_drive_sync.deprecated.py
tests/acceptance/_*.py
tests/acceptance/_*.txt
tests/acceptance/fixtures/v*_isolation_*.docx
tests/acceptance/reports/
# Keep the canonical test fixture (test_05 needs it)
# tests/acceptance/fixtures/test_volunteer_policy.docx IS committed

# Old built artifacts (the new build lives in client/dist/ and is
# created by client/build.py; these pre-built static dirs are stale).
api/static/admin/
api/static/index.html
api/static/client/

# Git credentials (stored by Windows credential helper)
Userskhayrat.git-credentials-safecredentials

# Diagnostic / one-off build output files (created during local debugging)
tests/_amend.txt
tests/_git_push.txt
tests/_git_staged.txt
tests/_local_build.txt
tests/_vercel_build_test.txt
tests/_vercel_build_test2.txt
tests/_*_output.txt
tests/_phase*_smoke.py
tests/_phase*_diag.py
tests/_phase*_demo.txt

# Drive ingestion is fully removed (deprecated). The whole directory
# is gitignored — the canonical import path is `rag.categories`.
drive/

# The `admin/` directory is the old admin panel (replaced by `client/`).
# It is kept locally for reference but is not part of the production app.
# All heavy build artifacts (node_modules, dist) are gitignored.
admin/node_modules/
admin/dist/
admin/tsconfig.tsbuildinfo
# NOTE: we keep admin/src/, admin/package.json, admin/index.html, and
# admin/build.py in the repo as historical reference. If you want to
# remove them entirely, do `rm -rf admin/` — but do that in a separate
# commit so the history is clear.

# Indexed/legacy data left over from initial development. Not part of
# the running app.
INDEX_*.json
INDEX_*.txt
how_to_connect.txt


