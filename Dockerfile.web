# Kateb web — FastAPI server (REST API + serves the built React client)
#
# Build:    docker build -f Dockerfile.web -t kateb-web .
# Run:      docker compose up -d web
#
# This image is self-contained: it builds the React client (Vite) so
# the api/static/client/ directory is fully populated. The image can
# serve the entire user-facing app from a single port (8000).
FROM python:3.11-slim

WORKDIR /app

# OS-level deps for python-docx, PyMuPDF (and `lxml` for python-docx)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libxml2-dev libxslt-dev curl \
        # LibreOffice for PDF export (optional — Word-only MVP doesn't need it,
        # but it's < 200 MB and lets the PDF route work on the VPS).
        libreoffice-core libreoffice-writer \
        fonts-noto fonts-noto-extra \
    && rm -rf /var/lib/apt/lists/*

# Python deps first (cache layer)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# App code
COPY . /app

# Build the client (Vite/React) so api/static/client/ is fully populated
WORKDIR /app/client
RUN npm ci || npm install
RUN npm run build
# build.py copies dist/ → api/static/client/
WORKDIR /app
RUN python client/build.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8

EXPOSE 8000

# Healthcheck: hit /api/health (the endpoint we expose for load balancers
# and uptime monitors)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

# Production: uvicorn with 2 workers. Override with `--workers 1` on
# a 1-vCPU VPS.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
